<Window x:Class="QuotaPeek.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuotaPeek 设置" Icon="/Assets/QuotaPeek.ico" Width="800" Height="720" MinWidth="710" MinHeight="540" WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}" Foreground="{StaticResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Grid Margin="25,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="让额度一目了然" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="连接账户，设置你的提醒和刷新节奏。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><TextBlock Text="QuotaPeek  /  0.1" Foreground="{StaticResource Mint}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="数据源" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/>
          <ListBox x:Name="ProviderList" DisplayMemberPath="Name" SelectionChanged="Provider_Changed" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0" MinHeight="105" MaxHeight="220" Padding="4">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" Padding="{TemplateBinding Padding}" CornerRadius="7" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#354959"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          </ListBox>
          <ComboBox x:Name="AddType" Margin="0,14,0,7" AutomationProperties.Name="添加数据源类型"/>
          <Button x:Name="AddButton" Content="＋ 添加数据源" Click="Add_Click"/>
          <Border Height="1" Background="{StaticResource Line}" Margin="0,20"/>
          <TextBlock Text="桌面偏好" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>
          <CheckBox x:Name="NotifyCheck" Content="额度低时通知"/>
          <CheckBox x:Name="FullscreenCheck" Content="全屏时自动隐藏"/>
          <CheckBox x:Name="TaskbarDockCheck" Content="嵌入左下角任务栏" ToolTip="胶囊显示在任务栏左侧空位，单击展开卡片；空间不足时自动使用悬浮胶囊。"/>
          <CheckBox x:Name="StartupCheck" Content="登录 Windows 时启动"/>
          <Button x:Name="SavePreferencesButton" Content="保存桌面偏好" Click="Preferences_Click" Margin="0,7,0,0"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="密钥由 Windows 凭据管理器保护。配置与历史仅保存在本机。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4"/>
      </Grid>
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="20">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="Editor">
            <Grid Margin="0,0,0,14"><TextBlock x:Name="TypeTitle" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="EnabledCheck" Content="启用" HorizontalAlignment="Right"/></Grid>
            <TextBlock Text="显示名称" Foreground="{StaticResource Muted}"/><TextBox x:Name="NameInput" MaxLength="32"/>
            <StackPanel x:Name="ApiFields">
              <TextBlock Text="API 地址" Foreground="{StaticResource Muted}"/><TextBox x:Name="BaseUrlInput"/>
              <StackPanel x:Name="HoneWalletFields" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="使用 Hone「安全与访问」中的账户访问令牌读取钱包余额。普通 API key 无法读取钱包。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
                <Button x:Name="WalletWebsiteButton" Content="打开 Hone 安全与访问" Click="WalletWebsite_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
              </StackPanel>
              <TextBlock x:Name="KeyLabel" Text="API key" Foreground="{StaticResource Muted}"/><PasswordBox x:Name="KeyInput"/>
              <TextBlock x:Name="KeyHint" Text="仅在本机保存，不会显示已有 key。" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,13"/>
              <TextBlock Text="或从此环境变量读取" Foreground="{StaticResource Muted}"/><TextBox x:Name="EnvironmentInput"/>
              <StackPanel x:Name="ConnectWalletFields" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="这里查询 API key 账单。需要账户钱包余额，请单独连接钱包。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
                <Button x:Name="ConnectWalletButton" Content="＋ 连接钱包余额" Click="ConnectWallet_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="CodexFields" Visibility="Collapsed">
              <Border Background="#233C36" CornerRadius="8" Padding="12" Margin="0,0,0,14"><TextBlock Text="使用这台电脑上已登录的 Codex 账户。自动读取额度窗口和重置时间，无需填写 API key。" Foreground="{StaticResource Mint}" TextWrapping="Wrap" FontSize="12"/></Border>
              <TextBlock Text="codex.exe 路径（留空自动查找）" Foreground="{StaticResource Muted}"/><TextBox x:Name="CodexPathInput"/>
            </StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="刷新间隔 / 分钟" Foreground="{StaticResource Muted}"/><TextBox x:Name="IntervalInput"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock x:Name="ThresholdLabel" Text="低额度阈值" Foreground="{StaticResource Muted}"/><TextBox x:Name="ThresholdInput"/></StackPanel>
            </Grid>
            <StackPanel x:Name="CurrencyFields"><TextBlock Text="币种" Foreground="{StaticResource Muted}"/><ComboBox x:Name="CurrencyInput"><ComboBoxItem Content="USD"/><ComboBoxItem Content="CNY"/></ComboBox></StackPanel>
            <StackPanel x:Name="RelayFields" Visibility="Collapsed"><TextBlock Text="usage 换算倍数（美分 → 元：0.01）" Foreground="{StaticResource Muted}"/><TextBox x:Name="UsageMultiplierInput"/><TextBlock Text="兼容账单可能按账户或 API key 统计；消费通常是累计值。首次连接后请与站点控制台核对。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,13"/></StackPanel>
            <StackPanel x:Name="ManualFields" Visibility="Collapsed">
              <TextBlock Text="手动余额（可留空）" Foreground="{StaticResource Muted}"/><TextBox x:Name="ManualRemainingInput"/>
              <TextBlock Text="手动已用（可留空）" Foreground="{StaticResource Muted}"/><TextBox x:Name="ManualUsedInput"/>
            </StackPanel>
            <StackPanel x:Name="CustomFields" Visibility="Collapsed">
              <TextBlock Text="金额类型" Foreground="{StaticResource Muted}"/><ComboBox x:Name="KindInput"><ComboBoxItem Content="余额型"/><ComboBoxItem Content="限额型"/><ComboBoxItem Content="花费型"/></ComboBox>
              <TextBlock Text="剩余字段路径（可留空）" Foreground="{StaticResource Muted}"/><TextBox x:Name="RemainingPathInput"/>
              <TextBlock Text="已用字段路径（可留空）" Foreground="{StaticResource Muted}"/><TextBox x:Name="UsedPathInput"/>
              <TextBlock Text="总额字段路径（可留空）" Foreground="{StaticResource Muted}"/><TextBox x:Name="TotalPathInput"/>
              <TextBlock Text="金额换算倍数" Foreground="{StaticResource Muted}"/><TextBox x:Name="MultiplierInput"/>
              <TextBlock Text="请求头模板 / JSON（密钥用 {key}）" Foreground="{StaticResource Muted}"/><TextBox x:Name="HeadersInput" AcceptsReturn="True" MinHeight="66" TextWrapping="Wrap"/>
              <TextBlock Text="路径支持 $.data.balance、$.items[0].value；不支持过滤器或通配符。" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>
            <StackPanel x:Name="BudgetFields" Visibility="Collapsed"><TextBlock Text="预算（选填，与已用金额周期一致）" Foreground="{StaticResource Muted}"/><TextBox x:Name="BudgetInput"/></StackPanel>
          </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="Actions" Grid.Row="1" Margin="0,12,0,0">
            <WrapPanel Margin="0,5,0,10"><Button x:Name="TestButton" Content="测试连接" Click="Test_Click" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="保存账户" Background="{StaticResource Mint}" Foreground="#15231D" Click="Save_Click"/></WrapPanel>
            <StackPanel Orientation="Horizontal"><Button x:Name="DeleteKeyButton" Content="清除密钥" Background="Transparent" Foreground="#FFB1A6" Padding="0,7,16,7" Click="DeleteKey_Click"/><Button x:Name="RemoveButton" Content="移除数据源" Background="Transparent" Foreground="{StaticResource Muted}" Padding="0,7" Click="Remove_Click"/></StackPanel>
        </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="StatusText" Text="更改账户后点击保存。关闭窗口不会保存未提交的更改。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,15,0,0" MinHeight="32"/>
  </Grid>
</Window>
