<UserControl x:Class="QuotaPeek.UI.TaskbarCapsuleView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="TaskbarCapsule" AutomationProperties.Name="QuotaPeek 任务栏胶囊"
             FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="{StaticResource Text}" UseLayoutRounding="True" Focusable="False">
  <Border CornerRadius="16" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="展开 / 收起额度卡片" Click="Expand_Click"/>
        <MenuItem Header="设置" Click="Settings_Click"/>
        <MenuItem Header="立即刷新" Click="Refresh_Click"/>
        <Separator/>
        <MenuItem Header="切回自由悬浮" Click="Undock_Click"/>
        <MenuItem Header="退出 QuotaPeek" Click="Exit_Click"/>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid Margin="5,0,5,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
      <Button x:Name="TaskbarExpandButton" Background="Transparent" Padding="6,0" Focusable="False" Click="Expand_Click" AutomationProperties.Name="展开或收起额度卡片">
        <Button.Template>
          <ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate>
        </Button.Template>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Mint}" HorizontalAlignment="Left"/>
          <TextBlock x:Name="ProviderText" Grid.Column="1" Text="QuotaPeek" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <TextBlock x:Name="BalanceText" Grid.Column="2" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
        </Grid>
      </Button>
      <Button x:Name="TaskbarMenuButton" Grid.Column="1" Background="Transparent" Padding="0" FontFamily="Segoe MDL2 Assets" Content="&#xE700;" FontSize="12" Foreground="{StaticResource Muted}" Focusable="False" Click="Menu_Click" AutomationProperties.Name="任务栏胶囊菜单"/>
    </Grid>
  </Border>
</UserControl>
